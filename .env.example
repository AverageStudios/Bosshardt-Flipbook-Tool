# ─── Bosshardt Flipbook Tool ─────────────────────────────────────────────
# Copy to .env.local and fill in. Find these in Supabase:
# Project Settings → API (or "API Keys").

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public "anon" key (or the new "publishable" key, sb_publishable_…).
# Only used as the API key header for signed uploads; RLS blocks it from the table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key (or the new "secret" key, sb_secret_…). SERVER ONLY — never
# expose it to the browser. Used for all database access and to issue upload URLs.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this app, used for share links and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: protect /dashboard, /new and the management API with a password
# (HTTP Basic Auth, any username). Public /f/... flipbook links stay open.
# Leave empty to disable.
DASHBOARD_PASSWORD=
