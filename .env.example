# ─── Bosshardt Flipbook Tool ─────────────────────────────────────────────
# Copy to .env.local (never commit it) and fill in from Supabase:
# Project Settings → API Keys, and Project Settings → Data API for the URL.

# Project URL (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (browser-safe). Only sent as the API key header on signed
# uploads; RLS stops it from reading or changing the flipbooks table.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Project URL for server-side code (same value as above)
SUPABASE_URL=https://your-project-ref.supabase.co

# Secret key. SERVER ONLY — never prefix with NEXT_PUBLIC_ or use it in client code.
SUPABASE_SECRET_KEY=sb_secret_your-key-here
