# ─── Bosshardt Flipbook Tool ─────────────────────────────────────────────
# Copy to .env.local (never commit it) and fill in from Supabase:
# Project Settings → API Keys, and Project Settings → Data API for the URL.

# Project URL (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (browser-safe). Only sent as the API key header on signed
# uploads; RLS stops it from reading or changing the flipbooks table.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Project URL for server-side code (same value as above)
SUPABASE_URL=https://your-project-ref.supabase.co

# Secret key. SERVER ONLY — never prefix with NEXT_PUBLIC_ or use it in client code.
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# Sites allowed to show /embed/[slug] (and /f/[slug]) inside an <iframe>.
# Space- or comma-separated origins; "*" allows any site. Optional: defaults to
# https://bosshardtrealty.com and every https subdomain of it. Every other page
# (dashboard, upload) can never be framed. Read at build time — redeploy after changing.
# EMBED_ALLOWED_ORIGINS=https://bosshardtrealty.com https://*.bosshardtrealty.com

# Domain the generated embed code points at. Optional: defaults to
# https://bosshardtflipbooks.com, whichever address the dashboard is opened from.
# NEXT_PUBLIC_EMBED_ORIGIN=https://bosshardtflipbooks.com
